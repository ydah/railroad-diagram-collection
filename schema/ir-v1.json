{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ydah.github.io/railroad-diagram-collection/schema/ir-v1.json",
  "type": "object",
  "required": ["schema", "language", "version", "source", "generator", "start", "terminals", "rules"],
  "properties": {
    "schema": {"const": 1},
    "language": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "start": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["repo", "ref", "commit", "path", "sha256", "license"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "license": {
          "type": "object", "required": ["name", "url"],
          "properties": {"name": {"type": "string", "minLength": 1}, "url": {"type": "string", "minLength": 1}}
        }
      }
    },
    "generator": {
      "type": "object", "required": ["frontend", "tool_version", "rdc"],
      "properties": {
        "frontend": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1},
        "rdc": {"type": "string", "minLength": 1}
      }
    },
    "terminals": {"type": "array", "items": {"$ref": "#/$defs/terminal"}},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "terminal": {
      "type": "object", "required": ["name", "display", "kind"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "alias": {"type": "string"},
        "display": {"type": "string"},
        "kind": {"enum": ["keyword", "punct", "class", "internal"]}
      }
    },
    "rule": {
      "type": "object", "required": ["name", "kind", "alternatives"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["normal", "accept", "midrule", "parameterized", "inline"]},
        "line": {"type": "integer", "minimum": 0},
        "origin": {
          "type": "object", "required": ["template", "args"],
          "properties": {"template": {"type": "string"}, "args": {"type": "array", "items": {"type": "string"}}}
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object", "required": ["symbols"],
            "properties": {"symbols": {"type": "array", "items": {"type": "string", "minLength": 1}}}
          }
        },
        "expr": {"$ref": "#/$defs/expr"}
      },
      "anyOf": [{"required": ["expr"]}, {"properties": {"alternatives": {"minItems": 1}}}]
    },
    "expr": {
      "oneOf": [
        {"type": "object", "required": ["t", "name"], "properties": {"t": {"enum": ["nt", "term"]}, "name": {"type": "string", "minLength": 1}}},
        {"type": "object", "required": ["t", "items"], "properties": {"t": {"enum": ["seq", "choice"]}, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expr"}}}},
        {"type": "object", "required": ["t", "item"], "properties": {"t": {"enum": ["opt", "star", "plus", "lookahead"]}, "item": {"$ref": "#/$defs/expr"}, "sep": {"$ref": "#/$defs/expr"}, "negative": {"type": "boolean"}}},
        {"type": "object", "required": ["t"], "properties": {"t": {"const": "eps"}}},
        {"type": "object", "required": ["t", "text"], "properties": {"t": {"const": "note"}, "text": {"type": "string"}}}
      ]
    }
  }
}
