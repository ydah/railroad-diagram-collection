diff --git a/lib/lrama/diagram.rb b/lib/lrama/diagram.rb
index 9858089..42faa6e 100644
--- a/lib/lrama/diagram.rb
+++ b/lib/lrama/diagram.rb
@@ -4,6 +4,12 @@
 module Lrama
   class Diagram
     class << self
+      def rule_id(name)
+        'r-' + name.encode(Encoding::UTF_8).bytes.map do |byte|
+          byte.chr.match?(/[A-Za-z0-9_]/) ? byte.chr : '~%02X' % byte
+        end.join
+      end
+
       # @rbs (IO out, Grammar grammar, String template_name) -> void
       def render(out:, grammar:, template_name: 'diagram/diagram.html')
         return unless require_railroad_diagrams
@@ -69,9 +75,20 @@ module Lrama

     # @rbs (String name, RailroadDiagrams::Diagram diagram, String result) -> void
     def add_diagram(name, diagram, result)
-      result << "\n<h2 class=\"diagram-header\">#{RailroadDiagrams.escape_html(name)}</h2>"
-      diagram.write_svg(result.method(:<<))
-      result << "\n"
+      id = self.class.rule_id(name)
+      label = RailroadDiagrams.escape_html(name)
+      result << "\n<h2 class=\"diagram-header\" id=\"#{id}\">#{label}</h2>"
+      result << "\n<div class=\"diagram-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"Diagram for #{label}\">"
+      diagram.attrs['role'] = 'group'
+      diagram.attrs['aria-labelledby'] = id
+      svg = +''
+      diagram.write_svg(svg.method(:<<))
+      result << svg.gsub(/<path\b([^>]*\bd=")([^"]*)("[^>]*\/>)/) do
+        prefix, data, suffix = Regexp.last_match(1), Regexp.last_match(2), Regexp.last_match(3)
+        data = data.gsub(/[hv]-?0(?:\.0+)?(?=[A-Za-z\s]|$)/, '')
+        data.match?(/[hlvaqcszt]/i) ? '<path' + prefix + data + suffix : ''
+      end
+      result << "</div>\n"
     end
   end
 end
diff --git a/lib/lrama/grammar/rule.rb b/lib/lrama/grammar/rule.rb
index b023b0e..eb009ac 100644
--- a/lib/lrama/grammar/rule.rb
+++ b/lib/lrama/grammar/rule.rb
@@ -126,7 +126,14 @@ module Lrama
           if r.term
             RailroadDiagrams::Terminal.new(r.id.s_value)
           else
-            RailroadDiagrams::NonTerminal.new(r.id.s_value)
+            item = RailroadDiagrams::NonTerminal.new(r.id.s_value)
+            href = "##{Lrama::Diagram.rule_id(r.id.s_value)}"
+            item.define_singleton_method(:write_svg) do |write|
+              write.call("<a href=\"#{href}\">")
+              super(write)
+              write.call('</a>')
+            end
+            item
           end
         end
       end
